{
  "type": "record",
  "name": "AddressUpdatedAvro",
  "namespace": "com.allstate.personal_data_service.avro",
  "fields": [
    { "name": "userId",        "type": "long" },
    { "name": "street",        "type": "string" },
    { "name": "city",          "type": "string" },
    { "name": "state",         "type": "string" },
    { "name": "zipCode",       "type": "string" },
    { "name": "timestamp",     "type": "long", "default": 0 },
    { "name": "eventSource",   "type": "string", "default": "personal_information_service" }
  ]
}
